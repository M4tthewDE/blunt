package components

import _ "embed"

//go:embed static/tmdb_primary_long_blue.svg
var tmdbLogo string

templ About(commitHash string, buildTime string) {
    <html>
        <head>
            <title>About</title>
                <link rel="icon" type="image/x-icon" href="/static/favicon.ico">
        </head>
        <div>
            <div style="width: 20em; height: 1em; margin-bottom: 1em;">
                @templ.Raw(tmdbLogo)
            </div>
            This product uses the TMDB API but is not endorsed or certified by TMDB.
            <hr>
            <a target="_blank" href="https://github.com/m4tthewDE/blunt">Source</a>
            <br>
            <label>Commit: { commitHash }</label>
            <br>
            <label>Time (UTC): { buildTime }</label>
        </div>
    </html>
}